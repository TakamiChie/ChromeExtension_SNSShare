{
  "manifest_version": 3,
  "name": "SNS Share Intent Launcher",
  "version": "1.0.0",
  "description": "現在のページのタイトルとURLを各SNSの投稿画面で共有するChrome拡張機能",
  "icons": {
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "permissions": [
    "clipboardWrite",
    "contextMenus",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "SNSに共有",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "background": {
    "service_worker": "src/background.js"
  }
}
