{
  "manifest_version": 3,
  "name": "SNS Share Intent Launcher",
  "version": "1.0.0",
  "description": "現在のページのタイトルとURLを各SNSの投稿画面で共有するChrome拡張機能",
  "permissions": [
    "tabs",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "SNSに共有",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html"
}